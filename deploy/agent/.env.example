# --- TinyOSControll agent ---
# Copy to `.env` and edit. One of these per managed server.

# BUILD_CONTEXT — the build context for docker-compose.yml: the path to the
# repository root, i.e. the directory that contains agent/, common/ and
# requirements.txt. It is resolved relative to the folder where
# docker-compose.yml is located, so an absolute path is the safest option:
#   - compose is in <repo>/deploy/agent       -> BUILD_CONTEXT=../../
#   - compose copied elsewhere, and the repo is at
#     /home/user/oscontroll                   -> BUILD_CONTEXT=/home/user/oscontroll
# If unset, docker-compose.yml falls back to ../.. (repo layout only).
BUILD_CONTEXT=../../

# How to reach main (the mTLS management listener).
MAIN_HOST=192.168.1.20
MAIN_PORT=9443

# Identity. AGENT_NAME must match an AGENT_<i>_NAME in main's .env; AGENT_TOKEN
# must equal main's AGENT_TOKEN.
AGENT_NAME=alpha
AGENT_TOKEN=change-me-shared-agent-token

# Comma-separated whitelist of containers this agent may control.
CONTAINERS=nginx,postgres

# Telemetry interval in seconds.
TELEMETRY_INTERVAL=1.0

# Host docker socket. Snap Docker: /var/snap/docker/current/docker.sock
DOCKER_SOCK=/var/run/docker.sock

# (optional, GPU only) Host path to the amd-smi binary, mounted into the
# container by docker-compose.gpu.yml. Default: /usr/bin/amd-smi.
#AMDSMI_HOST_PATH=/usr/bin/amd-smi
