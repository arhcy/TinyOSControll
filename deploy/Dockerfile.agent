FROM golang:1.27-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/osagent-agent ./cmd/osagent-agent

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/osagent-agent /usr/local/bin/osagent-agent
ENTRYPOINT ["/usr/local/bin/osagent-agent"]
