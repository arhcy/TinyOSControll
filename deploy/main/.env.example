# --- TinyOSControll main ---
# Copy to `.env` and edit. docker compose reads this file and passes it to the
# container (see docker-compose.yml `env_file`).

# BUILD_CONTEXT — the build context for docker-compose.yml: the path to the
# repository root, i.e. the directory that contains main/, common/ and
# requirements.txt. It is resolved relative to the folder where
# docker-compose.yml is located, so an absolute path is the safest option:
#   - compose is in <repo>/deploy/main        -> BUILD_CONTEXT=../../
#   - compose copied to ~/osagent, and the repo is cloned to
#     /home/user/oscontroll                   -> BUILD_CONTEXT=/home/user/oscontroll
# If unset, docker-compose.yml falls back to ../.. (repo layout only).
BUILD_CONTEXT=../../

# Web UI (HTTPS) and mTLS management listener ports (host network).
WEB_PORT=8443
MGMT_PORT=9443

# Tokens.
#   API_TOKEN  guards the web UI / JSON API / SSE (sent as X-API-Key).
#   AGENT_TOKEN is shared by every agent and verified (with the agent name)
#               on the mTLS channel.
API_TOKEN=change-me-web-token
AGENT_TOKEN=change-me-shared-agent-token

# Agents. AGENTS_COUNT = how many AGENT_<i>_* groups to read (i starts at 1).
# MAC is required for Wake-on-LAN; IP is optional (WoL destination when set).
AGENTS_COUNT=2
AGENT_1_NAME=alpha
AGENT_1_MAC=AA:BB:CC:DD:EE:FF
AGENT_1_IP=192.168.1.21
AGENT_2_NAME=beta
AGENT_2_MAC=11:22:33:44:55:66
AGENT_2_IP=192.168.1.22
