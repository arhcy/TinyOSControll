[Unit]
Description=OSControl host executor (allowlisted host commands)
After=local-fs.target

[Service]
Type=simple
User=osagent
Group=osagent
ExecStart=/usr/bin/python3 -B /opt/osagent/daemons/osagent_executor.py --socket /run/osagent/executor.sock
RuntimeDirectory=osagent
RuntimeDirectoryMode=0750
Restart=on-failure
RestartSec=2
# NoNewPrivileges is intentionally NOT set: the executor uses sudo for the
# two allowlisted commands (systemctl poweroff, amd-smi monitor).
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
